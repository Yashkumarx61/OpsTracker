<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpsTracker — IIS Configuration (web.config)
  Configures wfastcgi handler to serve the Flask app via IIS
  on an AWS Windows Server deployment.
-->
<configuration>
  <appSettings>
    <!-- Path to the Python interpreter -->
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\OpsTracker" />
    <add key="WSGI_HANDLER" value="app.app" />
    <add key="WSGI_LOG" value="C:\inetpub\logs\OpsTracker\wfastcgi.log" />
  </appSettings>

  <system.webServer>
    <handlers>
      <!-- wfastcgi handler — maps all requests to Flask -->
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\Python311\python.exe|C:\Python311\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!-- Serve static files directly via IIS for performance -->
    <staticContent>
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <mimeMap fileExtension=".png" mimeType="image/png" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- Remove Server header for security -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
