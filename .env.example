# ============================================================
# OpsTracker Enterprise Suite Environment Configuration
# Copy this file to .env and set secure production values.
# ============================================================

# Flask Core & Security
SECRET_KEY=enter-a-secure-random-64-char-key-here
FLASK_ENV=development
FLASK_DEBUG=1
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# SQLite / Database
DB_PATH=opstracker.db

# OpsMail Integration Specs (SMTP / IMAP Abstraction)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=ops-mailer
SMTP_PASSWORD=ops-mail-password
IMAP_HOST=imap.mailtrap.io
IMAP_PORT=993

# OpsMeet WebRTC Configuration
WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19020"}]
